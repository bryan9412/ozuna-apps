{
  "name": "Ozuna Ventas",
  "short_name": "Ozuna Ventas",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F5F4",
  "theme_color": "#0E6A5B",
  "icons": [
    {"src": "../iconos/ventas-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "../iconos/ventas-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "../iconos/ventas-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./recibir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [{"name": "archivo", "accept": ["text/plain", ".txt"]}]
    }
  }
}
